# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication
API_KEY=test_key
ADMIN_KEY=admin_secret_key

# Upload Configuration
# MAX_FILE_SIZE_MB is a soft limit: files above it trigger a confirmation prompt
# in the UI. HARD_MAX_FILE_SIZE_MB is the absolute ceiling (files above it are
# rejected); it defaults generously above the soft limit if left unset.
MAX_FILE_SIZE_MB=100
HARD_MAX_FILE_SIZE_MB=5120
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/webm,audio/mp4,audio/ogg,video/mp4,video/x-matroska
# Files are also accepted by extension (handles containers like .mkv whose MIME
# some browsers report as application/octet-stream).
ALLOWED_EXTENSIONS=.mp3,.wav,.webm,.mp4,.m4a,.ogg,.oga,.opus,.mkv,.mov,.flac,.aac,.avi,.wmv,.3gp
UPLOAD_DIR=./uploads

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000
ML_TRANSCRIBE_PATH=/transcribe
ML_HEALTH_PATH=/health
ML_SERVICE_TOKEN=
ML_HEALTHCHECK_ENABLED=true

# Supabase Configuration
# Get these from your Supabase project dashboard:
# https://app.supabase.com -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Legacy Database (deprecated, use Supabase instead)
DB_PATH=./whisperself.db
